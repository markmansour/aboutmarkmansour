---
import '@fontsource-variable/outfit';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Outfit Variable';
    --aw-font-serif: 'Outfit Variable';
    --aw-font-heading: 'Outfit Variable';

    --aw-color-primary: rgb(4 120 87);
    --aw-color-secondary: rgb(6 95 70);
    --aw-color-accent: rgb(4 120 87);

    --aw-color-text-heading: rgb(24 24 27);
    --aw-color-text-default: rgb(39 39 42);
    --aw-color-text-muted: rgb(39 39 42 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(24 24 27);

    ::selection {
      background-color: rgb(167 243 208);
    }
  }

  .dark {
    --aw-font-sans: 'Outfit Variable';
    --aw-font-serif: 'Outfit Variable';
    --aw-font-heading: 'Outfit Variable';

    --aw-color-primary: rgb(52 211 153);
    --aw-color-secondary: rgb(110 231 183);
    --aw-color-accent: rgb(52 211 153);

    --aw-color-text-heading: rgb(250 250 250);
    --aw-color-text-default: rgb(228 228 231);
    --aw-color-text-muted: rgb(228 228 231 / 66%);
    --aw-color-bg-page: rgb(24 24 27);

    ::selection {
      background-color: rgb(6 78 59);
      color: rgb(250 250 250);
    }
  }
</style>
